# pipefail-grep-q-src.allow -- read by bin/tests/pipefail-grep-q-ratchet.test.sh.
# Pipes into grep -q under pipefail that CANNOT race, kept as they are. One entry per line, TAB-separated:
#   <path>  <exact line text, leading/trailing blanks trimmed>  <why it cannot race>
# The race needs a second write into the pipe after grep has exited (pipefail-grep-q-ratchet header). Measured
# with strace: a builtin printf of a ONE-LINE value is 1 write; `ps -p <pid> -o args=` is 1 write.
# Anything that can be multi-line, or has a stage between producer and grep, is fixed instead (<<<).
# The list only shrinks: an entry whose line is gone fails as stale; a changed line must be re-justified.

bin/add-role.sh	printf '%s' "$role" | grep -Eq '^[a-z0-9][a-z0-9-]{0,39}$' \	one-line value (name/path/url/date/match/line): 1 write (measured)
bin/api-watchdog.sh	&& ps -p "$_prev" -o args= 2>/dev/null | grep -q 'api-watchdog'; then	ps -o args= of one pid: one line, 1 write (measured)
bin/approve.sh	if ! tmux -L orchestrator list-windows -t "$sess" -F '#{window_name}' 2>/dev/null | grep -qx orchestrator; then	tmux list-*: the tmux server writes the list, the client exits 0 when grep closes early (measured: 0 of 500 nonzero; the pipe misread 0 of 6000)
bin/check-scope.sh	printf '%s' "$unit" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9_-]*$' \	one-line value (name/path/url/date/match/line): 1 write (measured)
bin/cleanup.sh	tmux list-panes -s -t "$TEAM_SESSION" -F '#{pane_pid}' 2>/dev/null | grep -qx "$cl"; then	tmux list-*: the tmux server writes the list, the client exits 0 when grep closes early (measured: 0 of 500 nonzero; the pipe misread 0 of 6000)
bin/communicator.sh	| grep -Fxq communicator; then	tmux list-*: the tmux server writes the list, the client exits 0 when grep closes early (measured: 0 of 500 nonzero; the pipe misread 0 of 6000)
bin/gates/link-live.sh	[ -n "$exclude" ] && echo "$u" | grep -qE "$exclude" && continue	one-line value (name/path/url/date/match/line): 1 write (measured)
bin/launch-team.sh	printf '%s' "$role" | grep -Eq '^[a-z0-9][a-z0-9-]{0,39}$' \	one-line value (name/path/url/date/match/line): 1 write (measured)
bin/lib/roster.sh	is_claude() { ps -p "$1" -o args= 2>/dev/null | grep -q '[c]laude'; }	ps -o args= of one pid: one line, 1 write (measured)
bin/lib/team-dir-guard.sh	if kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o args= 2>/dev/null | grep -q '[c]laude'; then	ps -o args= of one pid: one line, 1 write (measured)
bin/lib/team-spawn.sh	&& ps -p "$_pid" -o args= 2>/dev/null | grep -q '[c]laude' \	ps -o args= of one pid: one line, 1 write (measured)
bin/lib/team-spawn.sh	&& ps -p "$oldpid" -o args= 2>/dev/null | grep -q 'bin/chrome-supervisor\.sh'; then	ps -o args= of one pid: one line, 1 write (measured)
bin/lib/team-spawn.sh	&& ps -p "$oldpid" -o args= 2>/dev/null | grep -q 'bin/disk-tmp-watchdog\.sh'; then	ps -o args= of one pid: one line, 1 write (measured)
bin/lib/team-spawn.sh	&& ps -p "$oldpid" -o args= 2>/dev/null | grep -q 'bin/host-ram-watchdog\.sh'; then	ps -o args= of one pid: one line, 1 write (measured)
bin/lib/team-spawn.sh	&& ps -p "$oldpid" -o args= 2>/dev/null | grep -q 'bin/observer\.sh'; then	ps -o args= of one pid: one line, 1 write (measured)
bin/lib/team-spawn.sh	&& ps -p "$oldpid" -o args= 2>/dev/null | grep -q 'bin/permission-mode-watchdog\.sh'; then	ps -o args= of one pid: one line, 1 write (measured)
bin/lib/team-spawn.sh	&& ps -p "$oldpid" -o args= 2>/dev/null | grep -q 'bin/tmux-watchdog\.sh'; then	ps -o args= of one pid: one line, 1 write (measured)
bin/lib/team-spawn.sh	if ! printf '%s' "$role" | grep -Eq '^[a-z0-9][a-z0-9-]{0,39}$'; then	one-line value (name/path/url/date/match/line): 1 write (measured)
bin/lib/team-spawn.sh	kill -0 "$p" 2>/dev/null && ps -p "$p" -o args= 2>/dev/null | grep -q 'bin/api-watchdog\.sh'	ps -o args= of one pid: one line, 1 write (measured)
bin/lib/team-spawn.sh	kill -0 "$p" 2>/dev/null && ps -p "$p" -o args= 2>/dev/null | grep -q 'bin/compaction-watchdog\.sh'	ps -o args= of one pid: one line, 1 write (measured)
bin/new-goal.sh	printf '%s' "$name" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9_-]*$' \	one-line value (name/path/url/date/match/line): 1 write (measured)
bin/retire-role.sh	tmux list-windows -t "$session" -F '#{window_id}' 2>/dev/null | grep -qx "$1"	tmux list-*: the tmux server writes the list, the client exits 0 when grep closes early (measured: 0 of 500 nonzero; the pipe misread 0 of 6000)
bin/role-activity.sh	printf '%s' "$role" | grep -Eq '^[a-z0-9][a-z0-9-]{0,39}$' \	one-line value (name/path/url/date/match/line): 1 write (measured)
bin/stop-team.sh	if tmux list-windows -t "$session" -F '#{window_name}' 2>/dev/null | grep -qx orchestrator; then	tmux list-*: the tmux server writes the list, the client exits 0 when grep closes early (measured: 0 of 500 nonzero; the pipe misread 0 of 6000)
bin/team-status.sh	if kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o args= 2>/dev/null | grep -q '[c]laude'; then	ps -o args= of one pid: one line, 1 write (measured)
bin/team-status.sh	if kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o args= 2>/dev/null | grep -q '[c]laude'; then	ps -o args= of one pid: one line, 1 write (measured)
bin/tmux-watchdog.sh	&& ps -p "$oldpid" -o args= 2>/dev/null | grep -q 'api-watchdog'; then	ps -o args= of one pid: one line, 1 write (measured)
bin/tmux-watchdog.sh	&& ps -p "$oldpid" -o args= 2>/dev/null | grep -q 'bin/observer\.sh'; then	ps -o args= of one pid: one line, 1 write (measured)
bin/tmux-watchdog.sh	&& ps -p "$oldpid" -o args= 2>/dev/null | grep -q 'bin/permission-mode-watchdog\.sh'; then	ps -o args= of one pid: one line, 1 write (measured)
bin/tmux-watchdog.sh	&& ps -p "$prev" -o args= 2>/dev/null | grep -q 'tmux-watchdog'; then	ps -o args= of one pid: one line, 1 write (measured)
bin/unit-start.sh	printf '%s' "$unit" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9_-]*$' \	one-line value (name/path/url/date/match/line): 1 write (measured)
