#!/usr/bin/env bash
# pre-push: run bin/privacy-scan.sh over every commit about to leave this
# machine. This repo is public; the scan blocks real home paths, identities,
# secrets, endpoints (see CLAUDE.md "Public repository: no private data").
#
# Install once per clone (hooks are not copied by git clone), one of:
#   ln -sfn ../../bin/hooks/pre-push .git/hooks/pre-push
#       adds this hook and leaves every other hook in .git/hooks running.
#   git config core.hooksPath bin/hooks
#       simpler, but core.hooksPath REPLACES .git/hooks: a hook kept there (a
#       pre-commit, say) silently stops running. Move such hooks into bin/hooks
#       first, or use the symlink.
#
# Args: $1 = remote name (the URL when pushing to a bare URL), $2 = remote URL.
# Stdin: one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
#
# OUTGOING = what THE DESTINATION lacks: commits reachable from the pushed sha and
# not from the remote sha git gives on stdin, nor from any ref the destination
# reports to `git ls-remote <url>` (ids present here). Remote-tracking refs are
# not used: they may be stale, and a push to a bare URL, or to a remote never
# fetched, has none (the whole history was then scanned and blocked on a known
# historical hit). This opens a second connection to the destination; if it
# cannot be listed, nothing is scanned and the push is refused.
#
# Per pushed ref, over the outgoing commits:
#   content   `git show` of each commit: added lines, file names, message. git is
#             told the exact format (--text, a/ b/ prefixes, no color, no textconv
#             or external diff, medium format, UTF-8): a `-diff` or `binary`
#             attribute printed "Binary files differ" in place of the content, and
#             diff.noprefix, color.ui=always, format.pretty or a log output
#             encoding each hid content or the message from the scan (measured
#             2026-11-10). Binary files are therefore scanned as text too.
#   known     a commit listed in config/privacy-known-history.txt (full 40-hex id,
#             one per line, # comments) was reviewed and accepted: its content scan
#             is skipped, its identity scan is not. A line that is not a full id
#             refuses the push.
#   identity  author and committer name and address of each commit (a diff
#             carries neither, so `git show` alone never checked them).
#             Public identities: PRIVACY_PUBLIC_IDENTITIES, see privacy-scan.sh.
#   tags      a pushed annotated tag is an object of its own, which rev-list peels
#             away: each tag object the destination lacks (nested tags followed)
#             has its message scanned as message lines and its tagger through the
#             identity scan.
#   moved     last, each named local ref must still point at the sha that was
#             scanned. Some transports (smart HTTP) resolve the ref NAME again
#             after this hook returns, so a commit made while the scan ran would
#             be sent unscanned. An explicit-sha push sends what it names.
set -uo pipefail
repo="$(git rev-parse --show-toplevel)"
url="${2:-}"
z40=0000000000000000000000000000000000000000
fail=0
refs="$(cat)"   # read once: the moved-ref check re-reads the same lines
show_opts=(--no-color --format=medium --encoding=UTF-8 --text --no-textconv --no-ext-diff
           --src-prefix=a/ --dst-prefix=b/)

outgoing=0
while read -r _ ls _ _; do
  [ -n "${ls:-}" ] && [ "$ls" != "$z40" ] && outgoing=1
done <<<"$refs"
[ "$outgoing" = 1 ] || exit 0   # nothing but deletions

# Reviewed historical commits: content scan skipped, ids matched exactly.
known_file="$repo/config/privacy-known-history.txt"
declare -A known=()
if [ -e "$known_file" ] || [ -L "$known_file" ]; then
  if [ ! -r "$known_file" ] || [ -d "$known_file" ]; then
    echo "pre-push: $known_file exists but is not readable; push aborted." >&2
    exit 1
  fi
  n=0
  while IFS= read -r l || [ -n "$l" ]; do
    n=$((n + 1))
    l="${l%%#*}"
    [[ "$l" =~ ^[[:space:]]*$ ]] && continue
    if [[ ! "$l" =~ ^[[:space:]]*([0-9a-f]{40})[[:space:]]*$ ]]; then
      echo "pre-push: $known_file line $n is not a full 40-character commit id; push aborted." >&2
      exit 1
    fi
    known[${BASH_REMATCH[1]}]=1
  done < "$known_file"
fi

# The destination's refs. Fail CLOSED: without them the outgoing set is unknown.
if [ -z "$url" ]; then
  echo "pre-push: no destination URL (argument 2), so the commits it lacks are unknown; push aborted." >&2
  exit 1
fi
if ! dest="$(git -C "$repo" ls-remote -- "$url" </dev/null 2>&1)"; then
  echo "pre-push: cannot list the refs of the destination $url (git ls-remote failed):" >&2
  printf '%s\n' "$dest" | sed 's/^/  /' >&2
  echo "pre-push: without them the commits it lacks are unknown, so nothing was scanned; push aborted." >&2
  echo "pre-push: make 'git ls-remote $url' succeed (URL, network, credentials), then push again." >&2
  exit 1
fi
dest_oids="$(printf '%s\n' "$dest" | awk '(length($1) == 40 || length($1) == 64) && $1 ~ /^[0-9a-f]+$/ { print $1 }' | sort -u)"
declare -A dest_has=()
for o in $dest_oids; do dest_has[$o]=1; done
# The destination's commits that exist here (tags peeled): the scan stops at them.
dest_commits=""
if [ -n "$dest_oids" ]; then
  if ! dest_commits="$(printf '%s^{commit}\n' $dest_oids | git -C "$repo" cat-file --batch-check='%(objectname) %(objecttype)' 2>&1)"; then
    echo "pre-push: cannot resolve the destination's refs here, push aborted:" >&2
    printf '%s\n' "$dest_commits" | sed 's/^/  /' >&2
    exit 1
  fi
  dest_commits="$(printf '%s\n' "$dest_commits" | awk '$2 == "commit" { print $1 }' | sort -u)"
fi

# scan_ids <label> < "<id> <field>:<value>" lines: the identity scan. Feed it
# with a here-string, never a pipe: a function at the end of a pipe runs in a
# subshell and its fail=1 would be lost.
scan_ids() {
  if ! bash "$repo/bin/privacy-scan.sh" --identities; then
    echo "pre-push: private data in $1, push aborted" >&2
    fail=1
  fi
}

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" = "$z40" ] && continue   # ref deletion: nothing outgoing
  # Annotated tags: the tag objects themselves, outer to inner.
  t="$local_sha"; depth=0
  while [ "$(git -C "$repo" cat-file -t "$t" 2>/dev/null)" = tag ]; do
    [ -n "${dest_has[$t]+x}" ] && break   # the destination has it, and all it points at
    depth=$((depth + 1))
    if [ "$depth" -gt 32 ] || ! body="$(git -C "$repo" cat-file tag "$t" 2>&1)"; then
      echo "pre-push: cannot read tag object $t, push aborted" >&2
      fail=1
      break
    fi
    # The message (all after the first blank line), indented as git show
    # indents a commit message, so every line is scanned as a message line.
    if ! printf '%s\n' "$body" | awk 'm { print "    " $0; next } /^$/ { m = 1 }' | bash "$repo/bin/privacy-scan.sh"; then
      echo "pre-push: private data in the message of tag object $t, push aborted" >&2
      fail=1
    fi
    tagger="$(printf '%s\n' "$body" | awk '/^$/ { exit } sub(/^tagger /, "") { print; exit }')"
    if [ -n "$tagger" ]; then
      tname="${tagger%% <*}"; temail="${tagger#*<}"; temail="${temail%%>*}"
      printf -v tids '%s tagger-name:%s\n%s tagger-email:%s' "${t:0:12}" "$tname" "${t:0:12}" "$temail"
      scan_ids "the tagger of tag object $t" <<<"$tids"
    fi
    t="$(printf '%s\n' "$body" | awk '/^$/ { exit } $1 == "object" { print $2; exit }')"
    [ -n "$t" ] || break
  done
  excl=()
  for o in $dest_commits; do excl+=("^$o"); done
  if [ "${remote_sha:-$z40}" != "$z40" ] && git -C "$repo" cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    excl+=("^$remote_sha")
  fi
  # Fail CLOSED: if rev-list itself errors, the outgoing set is unknown and
  # the push must not proceed unscanned (peer-review finding, 2026-07-11).
  if ! commits="$(printf '%s\n' "$local_sha" "${excl[@]}" | git -C "$repo" rev-list --stdin 2>&1)"; then
    echo "pre-push: rev-list failed for $local_sha, cannot enumerate outgoing commits, push aborted:" >&2
    printf '%s\n' "$commits" | sed 's/^/  /' >&2
    fail=1
    continue
  fi
  [ -n "$commits" ] || continue
  for c in $commits; do
    if [ -n "${known[$c]+x}" ]; then
      echo "pre-push: commit $c is listed in config/privacy-known-history.txt: content scan skipped, identities scanned" >&2
      continue
    fi
    if ! git -C "$repo" show "${show_opts[@]}" "$c" | bash "$repo/bin/privacy-scan.sh"; then
      echo "pre-push: private data in commit $c, push aborted" >&2
      fail=1
    fi
  done
  if ! ids="$(printf '%s\n' "$commits" | git -C "$repo" log --no-walk=unsorted --stdin --encoding=UTF-8 \
      --format='%h author-name:%an%n%h author-email:%ae%n%h committer-name:%cn%n%h committer-email:%ce' 2>&1)"; then
    echo "pre-push: cannot read commit identities, push aborted:" >&2
    printf '%s\n' "$ids" | sed 's/^/  /' >&2
    fail=1
    continue
  fi
  scan_ids "a commit author or committer" <<<"$ids"
done <<<"$refs"

while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" = "$z40" ] && continue
  case "$local_ref" in *[!0-9a-f]*) ;; *) continue ;; esac   # explicit sha: sent as given
  # Not peeled: for an annotated tag the pushed object is the tag itself.
  now="$(git -C "$repo" rev-parse -q --verify "$local_ref" 2>/dev/null)"
  [ "$now" = "$local_sha" ] && continue
  echo "pre-push: $local_ref moved while this hook ran: scanned $local_sha, it now points at ${now:-nothing}, which was not scanned. Push aborted; push again to scan the new tip." >&2
  fail=1
done <<<"$refs"
exit $fail
